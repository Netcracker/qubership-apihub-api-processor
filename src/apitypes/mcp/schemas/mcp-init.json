{
  "$comment": "Cross-version MCP schema: validates documents across supported protocol revisions (2024-11-05 … 2025-11-25) by requiring only fields stable across all of them, with additionalProperties:true for forward compatibility. Reference: https://github.com/modelcontextprotocol/modelcontextprotocol/blob/main/schema/2025-11-25/schema.json",
  "type": "object",
  "required": ["capabilities", "protocolVersion", "serverInfo"],
  "additionalProperties": true,
  "properties": {
    "capabilities": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "completions": { "type": "object", "additionalProperties": true },
        "experimental": { "type": "object", "additionalProperties": true },
        "logging": { "type": "object", "additionalProperties": true },
        "prompts": { "type": "object", "additionalProperties": true },
        "resources": { "type": "object", "additionalProperties": true },
        "tools": { "type": "object", "additionalProperties": true }
      }
    },
    "protocolVersion": { "type": "string" },
    "serverInfo": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "instructions": { "type": "string" }
  }
}
